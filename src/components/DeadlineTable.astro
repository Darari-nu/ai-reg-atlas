---
// 年表ページ用の「これからの期限」1行表（人が確認した期限だけ）。年で区切り、行をクリックで「やること・出典」が開く。
import type { UpcomingDeadline, Country } from '../lib/data';
import { DEADLINE_KIND_LABELS } from '../lib/data';

interface Props {
  deadlines: UpcomingDeadline[];
  countries: Record<string, Country>;
}
const { deadlines, countries } = Astro.props;
const SOON_DAYS = 90; // これ以内は強調（金の左罫線）

const groups: Array<{ year: string; items: UpcomingDeadline[] }> = [];
for (const d of deadlines) {
  const year = d.date.slice(0, 4);
  const last = groups[groups.length - 1];
  if (last && last.year === year) last.items.push(d);
  else groups.push({ year, items: [d] });
}

function sourceHost(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '出典';
  }
}
function leftLabel(n: number): string {
  if (n === 0) return '今日まで';
  return n === 1 ? 'あと1日' : `あと${n}日`;
}
---

<div id="dl-table">
  {groups.map((g) => (
    <div class="dl-year mt-4 first:mt-0">
      <p class="font-mono text-xs text-ink/40">{g.year}</p>
      <ul class="mt-1 divide-y divide-ink/10 border-y border-ink/15 bg-white">
        {g.items.map((d) => {
          const c = countries[d.country];
          const soon = SOON_DAYS >= d.daysLeft;
          return (
            <li class="dl-item" data-country={d.country}>
              <details id={`dl-${d.id}`} class="card-expand group scroll-mt-24">
                <summary
                  class={`flex flex-wrap items-center gap-x-3 gap-y-0.5 py-2 pl-3 pr-3 md:flex-nowrap ${
                    soon ? 'border-l-2 border-l-star-gold' : 'border-l-2 border-l-transparent'
                  }`}
                >
                  <time class="w-[5.5rem] shrink-0 font-mono text-xs text-ink/60">{d.date}</time>
                  <span class={`w-16 shrink-0 whitespace-nowrap font-mono text-xs ${soon ? 'font-medium text-ink' : 'text-ink/50'}`}>{leftLabel(d.daysLeft)}</span>
                  <span class="w-20 shrink-0 whitespace-nowrap text-xs text-ink/60">{c?.flag} {c?.name_ja ?? d.country}</span>
                  <span class="min-w-0 basis-full text-sm font-medium leading-snug md:basis-auto md:flex-1">{d.title}</span>
                  <span class="shrink-0 border border-ink/20 px-1.5 py-0.5 text-[10px] tracking-wide text-ink/60">{DEADLINE_KIND_LABELS[d.kind] ?? d.kind}</span>
                  <span class="shrink-0 font-mono text-xs text-ink/40 transition-transform group-open:rotate-90" aria-hidden="true">▸</span>
                </summary>
                <div class="expand-body">
                  <div class="space-y-3 border-t border-ink/10 bg-paper px-4 py-4 text-sm leading-relaxed">
                    <p><span class="mr-2 font-mono text-[10px] text-ink/40">WHO</span>{d.applies_to}</p>
                    <div class="border-l-2 border-star-gold pl-3">
                      <p class="font-mono text-[10px] text-ink/40">この日までにやること（解釈・AIによる整理。法的助言ではありません）</p>
                      <ul class="mt-1 list-disc space-y-1 pl-5">
                        {d.what_to_do?.map((t) => <li>{t}</li>)}
                      </ul>
                    </div>
                    <div class="flex flex-wrap items-center gap-x-5 gap-y-1 font-mono text-xs">
                      {d.sources.map((s) => (
                        <a href={s} rel="noopener" target="_blank" class="text-ink underline underline-offset-2">出典（{sourceHost(s)}）↗</a>
                      ))}
                      <span class="text-ink/40">確認日 {d.verified}</span>
                    </div>
                  </div>
                </div>
              </details>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</div>
