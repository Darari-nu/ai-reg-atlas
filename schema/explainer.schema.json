{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "explainer.schema.json",
  "title": "Explainer",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "model", "created_at", "record_id", "source_kind", "headline", "lead", "facts", "who_is_affected", "japan_impact", "next_steps", "unknowns", "glossary"],
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z]{2}-\\d{3}$" },
    "status": { "enum": ["draft", "published"] },
    "model": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "published_at": { "type": "string", "format": "date-time" },
    "record_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z]{2}-\\d{3}$" },
    "source_kind": { "enum": ["official", "media"] },
    "headline": { "type": "string", "minLength": 1, "maxLength": 40 },
    "lead": { "type": "string", "minLength": 1, "maxLength": 300 },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_url"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "who_is_affected": { "type": "string", "minLength": 1 },
    "japan_impact": { "type": "string", "minLength": 1 },
    "next_steps": { "type": "string", "minLength": 1 },
    "unknowns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "glossary": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "explanation"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
