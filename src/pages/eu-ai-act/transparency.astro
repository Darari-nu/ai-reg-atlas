import LightLayout from '../../layouts/LightLayout.astro';
import GuideArticle from '../../components/GuideArticle.astro';
import { getGuide } from '../../lib/data';

const g = getGuide('eu-ai-act-transparency');
---

<LightLayout title={`${g.title} — EU AI法 | AI Reg Atlas`} description={g.description}>
  <GuideArticle
    guide={g}
    crumbs={[
      { label: 'AI Reg Atlas', href: '/' },
      { label: 'EU', href: '/country/eu/' },
      { label: 'EU AI法', href: '/eu-ai-act/' },
      { label: '透明性の義務の実務' },
    ]}
  />
</LightLayout>
