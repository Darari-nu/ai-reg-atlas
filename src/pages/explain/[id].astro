---
import LightLayout from '../../layouts/LightLayout.astro';
import {
  getCountries,
  getPublishedExplainers,
  getUpdates,
  fmtDate,
  withBase,
  CHANGE_TYPE_LABELS,
} from '../../lib/data';

// published の解説だけ静的ページにする。下書き（draft）はここに出ないので dist にも生成されない
export function getStaticPaths() {
  const updates = getUpdates();
  return getPublishedExplainers().map((ex) => ({
    params: { id: ex.id },
    props: { explainer: ex, update: updates.find((u) => u.id === ex.record_id) ?? null },
  }));
}

const { explainer: ex, update } = Astro.props;
const country = update ? getCountries().find((c) => c.code === update.country) : undefined;
const media = ex.source_kind === 'media';
const sourceUrls = [...new Set([...(update?.sources ?? []), ...ex.facts.map((f) => f.source_url)])];
---

<LightLayout title={`${ex.headline} | AI Reg Atlas`} description={ex.lead}>
  <main class="mx-auto max-w-3xl px-5 py-8">
    <nav class="font-mono text-xs text-ink/50" aria-label="パンくず">
      <a href={withBase('/')} class="hover:underline">AI Reg Atlas</a>
      <span class="mx-1">›</span>
      {country && (
        <>
          <a href={withBase(`/country/${country.code}/#updates`)} class="hover:underline">{country.name_ja}</a>
          <span class="mx-1">›</span>
        </>
      )}
      <span>解説</span>
    </nav>

    <header class="mt-4">
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs">
        {country && <span class="text-lg leading-none">{country.flag}</span>}
        <time class="text-ink/60">{update ? update.date : fmtDate(ex.created_at)}</time>
        {country && <span class="text-ink/50">{country.name_ja}</span>}
        {update && (
          <span class="border border-ink/20 px-1.5 py-0.5 text-[10px] tracking-wide text-ink/60">
            {CHANGE_TYPE_LABELS[update.change_type] ?? update.change_type}
          </span>
        )}
        {media && (
          <span class="border border-ink/20 px-1.5 py-0.5 text-[10px] tracking-wide text-ink/60">報道</span>
        )}
      </p>
      <h1 class="mt-3 font-display text-2xl font-semibold leading-snug">{ex.headline}</h1>
      <p class="mt-4 text-base leading-relaxed text-ink/90">{ex.lead}</p>
    </header>

    {media && (
      <p class="mt-6 border border-ink/20 bg-white px-4 py-3 text-sm leading-relaxed text-ink/80">
        <span class="mr-2 font-mono text-[10px] tracking-wide text-ink/50">報道ベース</span>
        この解説は公式発表ではなく報道を出典としています。数字・日付・義務の範囲は、公式資料で確認できるまで確定情報として扱わないでください。
      </p>
    )}

    <!-- 事実: 資料に書いてあること -->
    <section class="mt-10" aria-labelledby="facts-h">
      <h2 id="facts-h" class="mb-3 flex flex-wrap items-baseline gap-x-3 font-display text-lg font-semibold">
        資料に書いてあること
        <span class="font-mono text-[10px] font-normal tracking-wide text-ink/50">FACTS</span>
      </h2>
      <ul class="space-y-2">
        {ex.facts.map((f) => (
          <li class="border-l-2 border-ink bg-white py-2 pl-4 pr-3 text-sm leading-relaxed shadow-[0_1px_2px_rgba(26,34,51,0.06)]">
            {f.text}
            <a href={f.source_url} rel="noopener" target="_blank" class="ml-2 whitespace-nowrap font-mono text-xs underline underline-offset-2">出典 ↗</a>
          </li>
        ))}
      </ul>
    </section>

    <!-- 解釈: AI による解説 -->
    <section class="mt-10" aria-labelledby="interp-h">
      <h2 id="interp-h" class="mb-1 flex flex-wrap items-baseline gap-x-3 font-display text-lg font-semibold">
        解釈（AIによる解説）
        <span class="font-mono text-[10px] font-normal tracking-wide text-ink/50">INTERPRETATION</span>
      </h2>
      <p class="mb-3 text-xs leading-relaxed text-ink/60">ここから先は資料の記述ではなく、AIによる読みです。判断の前に必ず元資料を確認してください。</p>
      <div class="space-y-4">
        <div class="border-l-2 border-star-gold bg-star-gold/10 py-3 pl-4 pr-3">
          <h3 class="font-mono text-[10px] tracking-wide text-ink/60">誰に効くか</h3>
          <p class="mt-1 text-sm leading-relaxed">{ex.who_is_affected}</p>
        </div>
        <div class="border-l-2 border-star-gold bg-star-gold/10 py-3 pl-4 pr-3">
          <h3 class="font-mono text-[10px] tracking-wide text-ink/60">日本の会社にとって</h3>
          <p class="mt-1 text-sm leading-relaxed">{ex.japan_impact}</p>
        </div>
        <div class="border-l-2 border-star-gold bg-star-gold/10 py-3 pl-4 pr-3">
          <h3 class="font-mono text-[10px] tracking-wide text-ink/60">今後の予定</h3>
          <p class="mt-1 text-sm leading-relaxed">{ex.next_steps}</p>
        </div>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="unknown-h">
      <h2 id="unknown-h" class="mb-3 font-display text-lg font-semibold">資料からは分からないこと</h2>
      {ex.unknowns.length === 0 ? (
        <p class="text-sm text-ink/50">特になし。</p>
      ) : (
        <ul class="list-disc space-y-1 pl-5 text-sm leading-relaxed text-ink/80">
          {ex.unknowns.map((u) => <li>{u}</li>)}
        </ul>
      )}
    </section>

    {ex.glossary.length > 0 && (
      <section class="mt-10" aria-labelledby="gloss-h">
        <h2 id="gloss-h" class="mb-3 font-display text-lg font-semibold">用語</h2>
        <dl class="space-y-2 text-sm leading-relaxed">
          {ex.glossary.map((g) => (
            <div>
              <dt class="inline font-medium">{g.term}</dt>
              <dd class="inline text-ink/75"> — {g.explanation}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <section class="mt-10" aria-labelledby="src-h">
      <h2 id="src-h" class="mb-3 font-display text-lg font-semibold">元資料</h2>
      <ul class="space-y-1 font-mono text-xs">
        {sourceUrls.map((s) => (
          <li><a href={s} rel="noopener" target="_blank" class="break-all underline underline-offset-2">{s}</a></li>
        ))}
      </ul>
      {country && (
        <p class="mt-4 font-mono text-xs">
          <a href={withBase(`/country/${country.code}/#u-${ex.record_id}`)} class="text-ink/70 underline underline-offset-2 hover:text-ink">
            {country.name_ja}ページの更新欄で見る →
          </a>
        </p>
      )}
    </section>

    <p class="mt-10 border-t border-ink/10 pt-4 text-xs leading-relaxed text-ink/60">
      AIが公開資料をもとに作成。正確な内容は元資料を確認してください。法的助言ではありません。
    </p>
  </main>
</LightLayout>
