---
// EU AI法 徹底解説（/eu-ai-act/）。中身は data/guides/eu-ai-act.json（一次資料で裏を取った静的な文章）を描くだけ。
// 日程表の「これからの期限」は data/deadlines.json（人が確認した期限）から、残り日数はビルド日（JST）で数える。
import LightLayout from '../layouts/LightLayout.astro';
import { getGuide, getUpcomingDeadlines, withBase, DEADLINE_KIND_LABELS } from '../lib/data';
import type { GuideBlock } from '../lib/data';
import { todayJst, daysUntil } from '../lib/upcomingDeadlines.mjs';

const g = getGuide('eu-ai-act');
const today = todayJst();

// 出典URL → 短い表示名（EUR-Lex は条・附属書・前文まで、欧州委員会は「欧州委員会」）
function srcLabel(url: string): string {
  let u: URL;
  try {
    u = new URL(url);
  } catch {
    return '出典';
  }
  const frag = u.hash.replace(/^#/, '');
  if (u.hostname === 'eur-lex.europa.eu') {
    const amend = url.includes('32026R1744');
    const law = amend ? '改正規則2026/1744' : 'AI法';
    let m;
    if ((m = frag.match(/^art_(\d+)$/))) return `${law} 第${m[1]}条`;
    if ((m = frag.match(/^anx_([IVX]+)$/))) return `${law} 附属書${m[1]}`;
    if ((m = frag.match(/^rct_(\d+)$/))) return `${law} 前文${m[1]}`;
    return `${law}（EUR-Lex）`;
  }
  if (u.hostname.endsWith('ec.europa.eu')) return '欧州委員会';
  return u.hostname.replace(/^www\./, '');
}

function blockSources(b: GuideBlock): string[] {
  switch (b.type) {
    case 'p':
    case 'list':
      return b.sources;
    case 'note':
      return b.sources ?? [];
    case 'table':
      return b.rows.flatMap((r) => r.sources);
    case 'risk_tiers':
      return b.tiers.flatMap((t) => t.sources);
    case 'checklist':
      return b.items.flatMap((i) => i.sources);
    case 'faq':
      return b.items.flatMap((i) => i.sources);
    case 'schedule':
      return g.milestones.flatMap((m) => m.sources);
    default:
      return [];
  }
}
const uniq = (xs: string[]) => [...new Set(xs)];
// 章末の出典は表示名でまとめる（同じ条を指すURLは1つに）
function sectionSources(blocks: GuideBlock[]) {
  const seen = new Map<string, string>();
  for (const url of uniq(blocks.flatMap(blockSources))) {
    const label = srcLabel(url);
    if (!seen.has(label)) seen.set(label, url);
  }
  return [...seen.entries()].map(([label, url]) => ({ label, url }));
}

// 日程表: 過去の節目（このページのデータ）と、先の期限（deadlines.json の EU 分＋このページの先の節目）
type Row = { date: string; text: string; kind?: string; dlId?: string; sources: string[] };
const past: Row[] = g.milestones.filter((m) => m.date <= today).map((m) => ({ date: m.date, text: m.event, sources: m.sources }));
const upcomingEu = getUpcomingDeadlines(today).filter((d) => d.source === 'curated' && d.country === 'eu');
const future: Row[] = [
  ...upcomingEu.map((d) => ({ date: d.date, text: d.title, kind: DEADLINE_KIND_LABELS[d.kind] ?? d.kind, dlId: d.id, sources: d.sources })),
  ...g.milestones.filter((m) => m.date > today).map((m) => ({ date: m.date, text: m.event, sources: m.sources })),
].sort((a, b) => (a.date < b.date ? -1 : a.date > b.date ? 1 : 0));

const tierStyle: Record<string, { bar: string; width: string }> = {
  prohibited: { bar: 'bg-diff-stricter', width: 'md:w-[55%]' },
  high: { bar: 'bg-star-gold', width: 'md:w-[70%]' },
  transparency: { bar: 'bg-diff-unique', width: 'md:w-[85%]' },
  minimal: { bar: 'bg-diff-looser', width: 'md:w-full' },
};

const toc = g.sections.map((s) => ({ id: s.id, label: `${s.number}. ${s.title}` }));
---

<LightLayout title={`${g.title} — 条文で確認した日本企業向けガイド | AI Reg Atlas`} description={g.description}>
  <main class="mx-auto max-w-6xl px-5 py-8">
    <nav class="font-mono text-xs text-ink/50" aria-label="パンくず">
      <a href={withBase('/')} class="hover:underline">AI Reg Atlas</a>
      <span class="mx-1">›</span>
      <a href={withBase('/country/eu/')} class="hover:underline">EU</a>
      <span class="mx-1">›</span>
      <span>EU AI法 徹底解説</span>
    </nav>

    <div class="mt-4 md:grid md:grid-cols-[13rem_minmax(0,1fr)] md:gap-10">
      <!-- 目次（PC: 左に固定） -->
      <aside class="hidden md:block">
        <nav class="sticky top-6 text-xs leading-relaxed" aria-label="目次">
          <p class="font-mono text-[10px] tracking-widest text-ink/40">CONTENTS</p>
          <ol class="mt-2 space-y-1.5 border-l border-ink/15 pl-3">
            <li><a href="#summary" class="text-ink/70 hover:text-ink hover:underline">0. ひとことで</a></li>
            {toc.map((t) => <li><a href={`#${t.id}`} class="text-ink/70 hover:text-ink hover:underline">{t.label}</a></li>)}
            <li><a href="#references" class="text-ink/70 hover:text-ink hover:underline">14. 出典一覧・更新履歴</a></li>
          </ol>
        </nav>
      </aside>

      <article class="min-w-0">
        <header>
          <h1 class="font-display text-2xl font-semibold md:text-3xl">{g.title}</h1>
          <p class="mt-2 text-sm text-ink/70">{g.description}</p>
          <p class="mt-2 font-mono text-xs text-ink/50">最終確認 {g.last_verified}（条文・欧州委員会の公式ページで確認）</p>
          <p class="mt-4 border-l-2 border-diff-stricter bg-white px-4 py-3 text-xs leading-relaxed text-ink/75">{g.disclaimer}</p>
        </header>

        <!-- 目次（スマホ: 折りたたみ） -->
        <details class="mt-5 border border-ink/15 bg-white md:hidden">
          <summary class="cursor-pointer select-none px-4 py-2.5 text-sm font-medium">目次</summary>
          <ol class="space-y-1.5 border-t border-ink/10 px-4 py-3 text-sm">
            <li><a href="#summary" class="underline-offset-2 hover:underline">0. ひとことで</a></li>
            {toc.map((t) => <li><a href={`#${t.id}`} class="underline-offset-2 hover:underline">{t.label}</a></li>)}
            <li><a href="#references" class="underline-offset-2 hover:underline">14. 出典一覧・更新履歴</a></li>
          </ol>
        </details>

        <!-- 0. ひとことで -->
        <section id="summary" class="mt-8 scroll-mt-6">
          <h2 class="font-display text-xl font-semibold">0. ひとことで</h2>
          <ul class="mt-3 space-y-2 border-2 border-star-gold bg-white p-5 text-sm leading-relaxed">
            {g.summary.map((s) => (
              <li class="flex gap-2">
                <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 bg-star-gold" aria-hidden="true"></span>
                <span>{s.text}</span>
              </li>
            ))}
          </ul>
        </section>

        {g.sections.map((sec) => {
          const secSources = sectionSources(sec.blocks);
          return (
            <section id={sec.id} class="mt-12 scroll-mt-6">
              <h2 class="font-display text-xl font-semibold">{sec.number}. {sec.title}</h2>
              <div class="mt-3 space-y-5 text-sm leading-relaxed">
                {sec.blocks.map((b) => {
                  if (b.type === 'p') {
                    return (
                      <div>
                        {b.heading && <h3 class="mb-1 font-bold">{b.heading}</h3>}
                        <p class="text-ink/85">{b.text}</p>
                      </div>
                    );
                  }
                  if (b.type === 'note') {
                    return <p class="border-l-2 border-ink/25 pl-3 text-xs text-ink/60">{b.text}</p>;
                  }
                  if (b.type === 'list') {
                    return (
                      <div>
                        {b.heading && <h3 class="mb-1 font-bold">{b.heading}</h3>}
                        <ul class="list-disc space-y-1 pl-5 text-ink/85">
                          {b.items.map((it) => <li>{it}</li>)}
                        </ul>
                      </div>
                    );
                  }
                  if (b.type === 'table') {
                    return (
                      <div id={b.id} class="scroll-mt-6">
                        {b.heading && <h3 class="mb-2 font-bold">{b.heading}</h3>}
                        {/* PC: 表 */}
                        <div class="hidden overflow-x-auto md:block">
                          <table class="w-full border-collapse bg-white text-left text-xs leading-relaxed">
                            <thead>
                              <tr class="border-b-2 border-ink/20">
                                {b.columns.map((c) => <th class="whitespace-nowrap px-3 py-2 font-bold">{c}</th>)}
                              </tr>
                            </thead>
                            <tbody>
                              {b.rows.map((r) => (
                                <tr class="border-b border-ink/10 align-top">
                                  {r.cells.map((cell, i) => (
                                    <td class={`px-3 py-2.5 ${i === 0 ? 'font-medium' : 'text-ink/80'}`}>
                                      {cell}
                                      {i === r.cells.length - 1 && (
                                        <span class="mt-1 block font-mono text-[10px] text-ink/45">
                                          {uniq(r.sources.map(srcLabel)).map((l, j) => (
                                            <a href={r.sources.find((u) => srcLabel(u) === l)} class="mr-2 underline underline-offset-2 hover:text-ink" target="_blank" rel="noopener">{l}</a>
                                          ))}
                                        </span>
                                      )}
                                    </td>
                                  ))}
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                        {/* スマホ: カード */}
                        <div class="space-y-2 md:hidden">
                          {b.rows.map((r) => (
                            <div class="border border-ink/15 bg-white p-3 text-xs leading-relaxed">
                              <p class="text-sm font-bold">{r.cells[0]}</p>
                              <dl class="mt-1.5 space-y-1.5">
                                {r.cells.slice(1).map((cell, i) => (
                                  <div>
                                    <dt class="font-mono text-[10px] text-ink/45">{b.columns[i + 1]}</dt>
                                    <dd class="text-ink/85">{cell}</dd>
                                  </div>
                                ))}
                              </dl>
                              <p class="mt-1.5 font-mono text-[10px] text-ink/45">
                                {uniq(r.sources.map(srcLabel)).map((l) => (
                                  <a href={r.sources.find((u) => srcLabel(u) === l)} class="mr-2 underline underline-offset-2" target="_blank" rel="noopener">{l}</a>
                                ))}
                              </p>
                            </div>
                          ))}
                        </div>
                        {b.caption && <p class="mt-2 text-xs text-ink/55">{b.caption}</p>}
                      </div>
                    );
                  }
                  if (b.type === 'risk_tiers') {
                    return (
                      <div class="space-y-2" role="list" aria-label="4つのリスク区分（上ほど厳しい）">
                        {b.tiers.map((t) => (
                          <div role="listitem" class={`mx-auto w-full ${tierStyle[t.key].width}`}>
                            <div class="flex items-stretch border border-ink/15 bg-white">
                              <span class={`w-2 shrink-0 ${tierStyle[t.key].bar}`} aria-hidden="true"></span>
                              <div class="px-3 py-2.5">
                                <p class="flex flex-wrap items-baseline gap-x-2">
                                  <span class="font-bold">{t.label}</span>
                                  <span class="font-mono text-[10px] text-ink/50">{t.basis}</span>
                                </p>
                                <p class="mt-0.5 text-xs text-ink/75">{t.text}</p>
                              </div>
                            </div>
                          </div>
                        ))}
                        <p class="text-center font-mono text-[10px] text-ink/40">↑ 上ほど義務が重い</p>
                      </div>
                    );
                  }
                  if (b.type === 'schedule') {
                    return (
                      <div class="space-y-6" id="schedule-table">
                        <div>
                          <h3 class="mb-2 font-bold">これからの期限</h3>
                          <ul class="divide-y divide-ink/10 border-y border-ink/15 bg-white">
                            {future.map((r) => {
                              const n = daysUntil(r.date, today);
                              return (
                                <li class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 px-3 py-2.5 md:flex-nowrap">
                                  <time class="w-[5.5rem] shrink-0 font-mono text-xs text-ink/70">{r.date}</time>
                                  <span class={`w-20 shrink-0 whitespace-nowrap font-mono text-xs ${n <= 90 ? 'font-medium text-ink' : 'text-ink/50'}`}>{n === 0 ? '今日まで' : `あと${n}日`}</span>
                                  <span class="min-w-0 basis-full text-sm leading-snug md:basis-auto md:flex-1">
                                    {r.text}
                                    {r.dlId && (
                                      <a href={withBase(`/timeline/#dl-${r.dlId}`)} class="ml-2 whitespace-nowrap font-mono text-[10px] text-ink/50 underline underline-offset-2">やること →</a>
                                    )}
                                  </span>
                                  {r.kind && <span class="shrink-0 border border-ink/20 px-1.5 py-0.5 text-[10px] text-ink/60">{r.kind}</span>}
                                </li>
                              );
                            })}
                          </ul>
                        </div>
                        <div>
                          <h3 class="mb-2 font-bold">これまでの節目</h3>
                          <ol class="relative ml-1 space-y-2 border-l border-ink/20 pl-4">
                            {past.map((r) => (
                              <li class="relative">
                                <span class="absolute -left-[1.3rem] top-1.5 h-2 w-2 rounded-full border border-ink/40 bg-paper" aria-hidden="true"></span>
                                <time class="font-mono text-xs text-ink/55">{r.date}</time>
                                <span class="ml-2 text-sm text-ink/85">{r.text}</span>
                              </li>
                            ))}
                          </ol>
                        </div>
                      </div>
                    );
                  }
                  if (b.type === 'checklist') {
                    return (
                      <div class="border border-ink/15 bg-white p-4">
                        {b.heading && <h3 class="mb-2 font-bold">{b.heading}</h3>}
                        <ul class="space-y-1.5">
                          {b.items.map((it) => (
                            <li class="flex gap-2">
                              <span class="mt-0.5 font-mono text-ink/40" aria-hidden="true">□</span>
                              <span class="text-ink/85">{it.text}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    );
                  }
                  if (b.type === 'faq') {
                    return (
                      <div class="divide-y divide-ink/10 border-y border-ink/15 bg-white">
                        {b.items.map((it) => (
                          <details class="group">
                            <summary class="flex cursor-pointer list-none items-start gap-2 px-3 py-3 font-medium [&::-webkit-details-marker]:hidden">
                              <span class="font-mono text-star-gold" aria-hidden="true">Q</span>
                              <span class="flex-1">{it.q}</span>
                              <span class="font-mono text-xs text-ink/40 transition-transform group-open:rotate-90" aria-hidden="true">▸</span>
                            </summary>
                            <div class="border-t border-ink/10 bg-paper px-3 py-3 text-ink/85">
                              <p>{it.a}</p>
                              <p class="mt-1.5 font-mono text-[10px] text-ink/45">
                                {uniq(it.sources.map(srcLabel)).map((l) => (
                                  <a href={it.sources.find((u) => srcLabel(u) === l)} class="mr-2 underline underline-offset-2" target="_blank" rel="noopener">{l}</a>
                                ))}
                              </p>
                            </div>
                          </details>
                        ))}
                      </div>
                    );
                  }
                  if (b.type === 'links') {
                    return (
                      <ul class="divide-y divide-ink/10 border-y border-ink/15 bg-white">
                        {b.items.map((it) => (
                          <li class="px-3 py-2.5">
                            <a href={withBase(it.href)} class="font-medium underline underline-offset-2">{it.label} →</a>
                            {it.note && <span class="mt-0.5 block text-xs text-ink/65">{it.note}</span>}
                          </li>
                        ))}
                      </ul>
                    );
                  }
                  return null;
                })}
              </div>
              {secSources.length > 0 && (
                <p class="mt-4 font-mono text-[10px] leading-relaxed text-ink/45">
                  出典:{' '}
                  {secSources.map((s) => (
                    <a href={s.url} class="mr-2 underline underline-offset-2 hover:text-ink" target="_blank" rel="noopener">{s.label}</a>
                  ))}
                </p>
              )}
            </section>
          );
        })}

        <!-- 14. 出典一覧・更新履歴 -->
        <section id="references" class="mt-12 scroll-mt-6">
          <h2 class="font-display text-xl font-semibold">14. 出典一覧・更新履歴</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {g.references.map((r) => (
              <li>
                <a href={r.url} class="underline underline-offset-2" target="_blank" rel="noopener">{r.label}</a>
                {r.note && <span class="block text-xs text-ink/55">{r.note}</span>}
              </li>
            ))}
          </ul>
          <h3 class="mt-6 font-bold">更新履歴</h3>
          <ul class="mt-2 space-y-1 text-xs text-ink/70">
            {g.changelog.map((c) => <li><time class="mr-2 font-mono">{c.date}</time>{c.note}</li>)}
          </ul>
          <p class="mt-6 border-l-2 border-diff-stricter bg-white px-4 py-3 text-xs leading-relaxed text-ink/75">{g.disclaimer}</p>
        </section>
      </article>
    </div>
  </main>
</LightLayout>
