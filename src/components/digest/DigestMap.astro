---
// 週報の図1: その週に動いた国の点の地図（正距円筒。陸地は Natural Earth 1:110m＝world-atlas）。
// 監視している国は薄い点、その週に動いた国は金の輪、「今週の変化3つ」の国は金の塗りに番号。
// 位置は config/countries.yaml の lat/lng。ビルド時に SVG を組む（クライアント JS なし）。
// PC は世界全体、スマホ（768px 未満）は動いた国のまわりを拡大した枠を出す。点と字の大きさは枠の幅に合わせて変える。
import DiagramFrame from '../diagrams/DiagramFrame.astro';
import { equirect, focusBox } from '../../lib/digests.mjs';
import { landPath } from '../../lib/worldLand.mjs';
import type { Country } from '../../lib/data';

interface Props {
  countries: Country[];
  mainCodes: { code: string; n: number }[]; // 変化3つの国（同じ国が2回なら番号2つ）
  otherCodes: string[]; // その他の動きの国
  n: number;
}
const { countries, mainCodes, otherCodes, n } = Astro.props;

const W = 720;
// 南極・北極の帯は使わないので切る（北緯80〜南緯56）
const Y0 = equirect(80, 0, W).y;
const Y1 = equirect(-56, 0, W).y;
const byCode = Object.fromEntries(countries.map((c) => [c.code, c]));

const mainMap = new Map<string, number[]>();
for (const m of mainCodes) mainMap.set(m.code, [...(mainMap.get(m.code) ?? []), m.n]);
const others = [...new Set(otherCodes)].filter((c) => !mainMap.has(c) && byCode[c]);

const base = countries.map((c) => ({ ...equirect(c.lat, c.lng, W), code: c.code }));
const mains = [...mainMap.entries()]
  .filter(([c]) => byCode[c])
  .map(([c, ns]) => ({ ...equirect(byCode[c].lat, byCode[c].lng, W), code: c, ns, name: byCode[c].name_ja, flag: byCode[c].flag }));
const otherPts = others.map((c) => ({ ...equirect(byCode[c].lat, byCode[c].lng, W), code: c }));

const land = landPath(W);
// PC: 世界（南極・北極の帯は切る＝北緯80〜南緯56）。スマホ: 動いた国のまわり
const world = { x: 0, y: Y0, w: W, h: Y1 - Y0 };
const moved = [...mains, ...otherPts].map((p) => ({ lat: byCode[p.code].lat, lng: byCode[p.code].lng }));
const focus = focusBox(moved, W);
const views = [
  { box: world, k: 1, cls: 'dgm-wide' },
  { box: focus, k: focus.w / 325, cls: 'dgm-narrow' },
];

const lats = [60, 30, 0, -30];
const lngs = [-150, -120, -90, -60, -30, 0, 30, 60, 90, 120, 150];

const names = mains.map((m) => m.name).join('・');
const alt = `今週動いた国を世界地図の点で示した図。今週の変化3つは${names}。そのほか${others.length}か国で動きがありました。`;
---

<DiagramFrame id="digest-map" n={n} title="今週、どこが動いたか" lead="金の番号が「今週の変化3つ」、金の輪はそのほかの動き、薄い点は監視している国です。" alt={alt}>
  <!-- 陸地の線は1回だけ載せ、PC 用とスマホ用の両方の地図から参照する -->
  <svg width="0" height="0" class="dgm-defs" aria-hidden="true"><defs><path id="dgm-land-path" d={land} /></defs></svg>
  {views.map((v) => (
    <svg viewBox={`${v.box.x} ${v.box.y} ${v.box.w} ${v.box.h}`} class={`dgm-svg ${v.cls}`} aria-hidden="true">
      <use href="#dgm-land-path" class="dgm-land" />
      {lats.map((la) => {
        const y = equirect(la, 0, W).y;
        return <line x1="0" x2={W} y1={y} y2={y} class={la === 0 ? 'dgm-eq' : 'dgm-grid'} stroke-width={v.k} />;
      })}
      {lngs.map((lo) => {
        const x = equirect(0, lo, W).x;
        return <line x1={x} x2={x} y1="0" y2={W / 2} class="dgm-grid" stroke-width={v.k} />;
      })}
      {base.map((p) => <circle cx={p.x} cy={p.y} r={3 * v.k} class="dgm-base" />)}
      {otherPts.map((p) => <circle cx={p.x} cy={p.y} r={7 * v.k} class="dgm-other" stroke-width={2 * v.k} />)}
      {mains.map((p) => (
        <g>
          <circle cx={p.x} cy={p.y} r={22 * v.k} class="dgm-halo" />
          <circle cx={p.x} cy={p.y} r={13 * v.k} class="dgm-main" />
          <text x={p.x} y={p.y + 5 * v.k} text-anchor="middle" class="dgm-num" font-size={15 * v.k}>{p.ns.join('')}</text>
          <text x={p.x} y={p.y - 20 * v.k} text-anchor="middle" class="dgm-label" font-size={15 * v.k} stroke-width={4 * v.k}>{p.name}</text>
        </g>
      ))}
    </svg>
  ))}
  <ol class="dgm-legend">
    {mains.map((p) => (
      <li><span class="dgm-legend-n">{p.ns.join('・')}</span>{p.flag} {p.name}</li>
    ))}
  </ol>
</DiagramFrame>

<style is:global>
  .dgm-svg { width: 100%; height: auto; }
  .dgm-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .dgm-narrow { display: block; }
  .dgm-wide { display: none; }
  @media (min-width: 768px) { .dgm-narrow { display: none; } .dgm-wide { display: block; } }
  .dgm-land { fill: color-mix(in srgb, var(--dg-fg) 9%, transparent); stroke: color-mix(in srgb, var(--dg-fg) 22%, transparent); stroke-width: 0.5; vector-effect: non-scaling-stroke; }
  .dgm-grid { stroke: var(--dg-line-soft); vector-effect: non-scaling-stroke; }
  .dgm-eq { stroke: var(--dg-line); stroke-dasharray: 4 4; vector-effect: non-scaling-stroke; }
  .dgm-base { fill: var(--dg-line); }
  .dgm-other { fill: none; stroke: var(--star-gold); }
  .dgm-halo { fill: color-mix(in srgb, var(--star-gold) 18%, transparent); }
  .dgm-main { fill: var(--star-gold); }
  .dgm-num { fill: var(--navy-deep); font-family: 'IBM Plex Mono', monospace; font-weight: 500; }
  .dgm-label { fill: var(--dg-fg); font-weight: 700; paint-order: stroke; stroke: var(--dg-bg); }
  .dgm-legend { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 14px; }
  .dgm-legend li { display: inline-flex; align-items: center; gap: 6px; }
  .dgm-legend-n {
    min-width: 22px; height: 22px; padding: 0 4px; border-radius: 11px; display: inline-grid; place-items: center;
    background: var(--star-gold); color: var(--navy-deep); font-family: 'IBM Plex Mono', monospace; font-size: 12px;
  }
</style>
