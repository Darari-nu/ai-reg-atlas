# Google AI Studio で発行した Gemini API キー（値は絶対にコミットしない）
GEMINI_API_KEY=

# 以下は任意（未設定ならコードの既定値）。Actions では Repository Variables で差し替える
# GEMINI_MODEL_TRIAGE=gemini-3.5-flash-lite
# GEMINI_FALLBACK_TRIAGE=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.5-flash  # カンマ区切り。待たずに順に1周する
# GEMINI_MODEL_SUMMARIZE=gemini-3.6-flash
# GEMINI_FALLBACK_SUMMARIZE=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# GEMINI_WAIT_BUDGET_SEC=600                          # 1ステップで待つ時間の累計上限
# GEMINI_MAX_ATTEMPTS=3                               # モデル列を何周するか（429/408/5xx）
# GEMINI_BACKOFF_BASE_MS=20000                        # バックオフ基点（20s→40s…、RetryInfoがあればそちら優先）
# TRIAGE_BATCH_SIZE=40                                # triage の1リクエストあたり候補数
# SCRAPE_HASH_MAX_AGE_DAYS=30                        # scrape_hash の一覧リンクをこの日数より古ければ候補にしない
# SUMMARIZE_MAX_PER_RUN=8                             # 1回の実行で要約する上限。あふれは data/state/queue.json に繰り越す
# SEEN_URL_TTL_DAYS=30                                # data/state/seen_urls.json（判定済みURL）の保持日数
# LAST_SEEN_MAX_LOOKBACK_DAYS=14                      # last_seen がどれだけ古くてもこの日数より前には遡らない
