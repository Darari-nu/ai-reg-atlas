{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "guide.schema.json",
  "title": "Guide",
  "description": "一次資料で裏を取った静的な解説ページ（data/guides/*.json）。自動生成しない。sources は各段落・各表の行の出典URL。example ブロックは架空の具体例。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "last_verified",
    "disclaimer",
    "summary",
    "milestones",
    "sections",
    "references",
    "changelog"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "parent": {
      "description": "親ガイドの id（子ページのとき）",
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "last_verified": {
      "$ref": "#/definitions/ymd"
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "summary_title": {
      "description": "0章の見出し（省略時「ひとことで」）",
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/definitions/sourced_text"
      }
    },
    "milestones": {
      "description": "このページで持つ日付（過去の節目と、data/deadlines.json に無い先の節目）。先の期限の正本は deadlines.json",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "event",
          "sources"
        ],
        "properties": {
          "date": {
            "$ref": "#/definitions/ymd"
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "$ref": "#/definitions/sources"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "number",
          "title",
          "blocks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "number": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/block"
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "note"
        ],
        "properties": {
          "date": {
            "$ref": "#/definitions/ymd"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "children": {
      "description": "子ページへの案内（目次と本文に出す）",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "href"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "href": {
            "type": "string",
            "pattern": "^/"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "ymd": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "sourced_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "sources"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "$ref": "#/definitions/sources"
        }
      }
    },
    "block": {
      "type": "object",
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": [
            "type",
            "text",
            "sources"
          ],
          "properties": {
            "type": {
              "const": "p"
            },
            "heading": {
              "type": "string"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "$ref": "#/definitions/sources"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "note"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "$ref": "#/definitions/sources"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "items",
            "sources"
          ],
          "properties": {
            "type": {
              "const": "list"
            },
            "heading": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sources": {
              "$ref": "#/definitions/sources"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "columns",
            "rows"
          ],
          "properties": {
            "type": {
              "const": "table"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "heading": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            },
            "columns": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cells",
                  "sources"
                ],
                "properties": {
                  "cells": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "string"
                    }
                  },
                  "sources": {
                    "$ref": "#/definitions/sources"
                  }
                }
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "tiers"
          ],
          "properties": {
            "type": {
              "const": "risk_tiers"
            },
            "tiers": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "label",
                  "basis",
                  "text",
                  "sources"
                ],
                "properties": {
                  "key": {
                    "enum": [
                      "prohibited",
                      "high",
                      "transparency",
                      "minimal"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sources": {
                    "$ref": "#/definitions/sources"
                  }
                }
              }
            }
          }
        },
        {
          "description": "data/deadlines.json の先の期限（country で絞る）＋ milestones を描く",
          "additionalProperties": false,
          "required": [
            "type",
            "country"
          ],
          "properties": {
            "type": {
              "const": "schedule"
            },
            "country": {
              "type": "string",
              "pattern": "^[a-z]{2}$"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "checklist"
            },
            "heading": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/sourced_text"
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "faq"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "q",
                  "a",
                  "sources"
                ],
                "properties": {
                  "q": {
                    "type": "string",
                    "minLength": 1
                  },
                  "a": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sources": {
                    "$ref": "#/definitions/sources"
                  }
                }
              }
            }
          }
        },
        {
          "description": "サイト内リンク（href はサイト内パス）",
          "additionalProperties": false,
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "links"
            },
            "heading": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "href"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "href": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "description": "架空の具体例（出典は不要。ページで「架空の例」と明示する）",
          "additionalProperties": false,
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "example"
            },
            "title": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "description": "手続きの流れ（段階ごとに条文の出典つき）",
          "additionalProperties": false,
          "required": [
            "type",
            "steps"
          ],
          "properties": {
            "type": {
              "const": "flow"
            },
            "steps": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "text",
                  "basis",
                  "sources"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sources": {
                    "$ref": "#/definitions/sources"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
