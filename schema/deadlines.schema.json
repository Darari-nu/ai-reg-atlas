{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "deadlines.schema.json",
  "title": "Deadlines",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "country", "date", "kind", "title", "what_to_do", "applies_to", "sources", "verified"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "country": { "type": "string", "pattern": "^[a-z]{2}$" },
      "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "kind": { "enum": ["obligation_applies", "transition_end", "in_force", "consultation_deadline", "other"] },
      "title": { "type": "string", "minLength": 1, "maxLength": 40 },
      "what_to_do": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string", "minLength": 1 } },
      "applies_to": { "type": "string", "minLength": 1 },
      "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https?://" } },
      "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
    }
  }
}
